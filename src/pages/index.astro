---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allCategories = Array.from(
  new Set(allPosts.flatMap((post) => post.data.categories))
).sort();

function estimateMinutes(body?: string) {
  if (!body) return 4;
  const words = body.trim().split(/\s+/).length;
  return Math.max(2, Math.round(words / 220));
}
---

<BaseLayout title="SUN's Blog">
  <div class="narrow-shell">
    <section class="masthead">
      <div class="masthead-cli">
        <div class="masthead-cli-cmd">
          <span class="mc-sigil">~$</span>
          <span class="mc-cmd">ls</span>
          <span class="mc-flag">-lt</span>
          <span class="mc-arg">~/notes/</span>
        </div>
        <div class="masthead-cli-out">
          <span class="mc-arrow">&rdsh;</span>
          <span>systems &middot; gpu computing &middot; applied math</span>
        </div>
      </div>
      <h1>SUN's Blog</h1>
      <p class="masthead-desc">
        Notes from hard technical lessons, written down to remind my future self and help anyone debugging the same seam between math and hardware.
      </p>
    </section>

    {allCategories.length > 0 && (
      <div class="topic-filter-bar" role="toolbar" aria-label="Filter notes by topic">
        <span class="filter-prompt">--tag=</span>
        <button type="button" class="filter-chip active" data-filter="all">*</button>
        {allCategories.map((cat) => (
          <button type="button" class="filter-chip" data-filter={cat}>
            #{cat}
          </button>
        ))}
      </div>
    )}

    <div class="post-list" id="post-list">
      {allPosts.map((post) => {
        const formattedDate = post.data.pubDate.toISOString().slice(0, 10);
        const mins = estimateMinutes(post.body);
        const ext = post.data.interactive ? 'mdx' : 'md';
        return (
          <a
            href={`${base}/posts/${post.id}/`}
            class="post-card"
            data-categories={post.data.categories.join(',')}
          >
            <div class="post-card-chrome">
              <span class="pc-dots" aria-hidden="true">
                <span class="pc-dot pc-dot-r"></span>
                <span class="pc-dot pc-dot-y"></span>
                <span class="pc-dot pc-dot-g"></span>
              </span>

              <div class="pc-chrome-right">
                {post.data.interactive && <span class="badge-interactive">INTERACTIVE</span>}
                {post.data.notebookSource && <span class="badge-notebook">IPYNB</span>}
                <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                <span>&middot;</span>
                <span>{mins}m</span>
              </div>
            </div>

            <div class="post-card-body">
              <div class="pc-cmd-preview">
                <span class="mc-sigil">~$</span>
                <span class="mc-cmd">less</span>
                <span class="mc-arg">posts/{post.id}.{ext}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>

            <div class="post-card-statusbar">
              <div class="post-card-tags">
                {post.data.categories.map((cat) => (
                  <span class="tag-pill">#{cat}</span>
                ))}
              </div>
              <span class="pc-open-hint">open buffer &crarr;</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <script>
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.post-card[data-categories]');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter || 'all';
        chips.forEach((c) => c.classList.toggle('active', c === chip));
        cards.forEach((card) => {
          const cats = (card.dataset.categories || '').split(',').filter(Boolean);
          const show = filter === 'all' || cats.includes(filter);
          card.style.display = show ? 'block' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
