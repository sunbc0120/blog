---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<BaseLayout
  title="About"
  description="Baichuan Sun - Distributed GPU infrastructure, reinforcement learning post-training, and first-principles applied math."
>
  <div class="about-shell">
    <div class="term-window" id="about-terminal">
      <!-- Terminal Chrome & Tab Strip -->
      <div class="term-chrome">
        <div class="term-lights" aria-hidden="true">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>

        <div class="term-tabs" role="tablist" aria-label="Bio terminal tabs">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-card"
            id="tab-card"
            class="term-tab active"
            data-tab="card"
          >
            <span class="tab-idx">1</span>
            <span>mcp-card.json</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-stack"
            id="tab-stack"
            class="term-tab"
            data-tab="stack"
          >
            <span class="tab-idx">2</span>
            <span>roofline-stack.sh</span>
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-log"
            id="tab-log"
            class="term-tab"
            data-tab="log"
          >
            <span class="tab-idx">3</span>
            <span>git-log</span>
          </button>
        </div>

        <div class="term-tty-meta">zsh &middot; utf-8 &middot; tty0</div>
      </div>

      <!-- Terminal Viewport -->
      <div class="term-viewport" id="term-viewport">
        <!-- TAB 1: MCP ENGINEER MODEL CARD -->
        <section
          id="panel-card"
          role="tabpanel"
          aria-labelledby="tab-card"
          class="term-panel active"
          data-panel="card"
        >
          <div class="cmd-line">
            <span class="t-sigil">~$</span>
            <span class="t-cmd">mcp inspect</span>
            <span class="t-flag">--card</span>
            <span class="t-arg">mcp://sun.blog/baichuan-sun</span>
          </div>

          <div class="mcp-banner">
            <div class="mcp-banner-top">
              <div>
                <span class="t-badge-emerald">MCP CARD v2026</span>
                <span class="t-badge-cyan">APPLIED AI &amp; GPU SYSTEMS</span>
              </div>
              <span class="t-comment">// status: active &middot; melbourne, au (UTC+11)</span>
            </div>
            <h1 class="mcp-name">Baichuan Sun, PhD</h1>
            <p class="mcp-tagline">
              Physicist turned distributed GPU &amp; ML systems architect. Interested in what actually happens between the
              mathematical objective, the compiler IR, the HBM memory controller, and the network NIC.
            </p>
          </div>

          <div class="kv-grid">
            <div class="kv-row">
              <span class="kv-key">"current_role"</span>
              <span class="kv-val">
                Applied Solutions Architect (<span class="t-str">"Google Cloud"</span>, APAC)
              </span>
            </div>
            <div class="kv-row">
              <span class="kv-key">"primary_obsessions"</span>
              <span class="kv-val">
                [<span class="t-str">"On-Policy RL (GRPO / PPO)"</span>{', '}
                <span class="t-str">"Multi-Node GPU Sharding (FSDP2 / vLLM)"</span>{', '}
                <span class="t-str">"Triton &amp; PyTorch Compiler"</span>{', '}
                <span class="t-str">"Deterministic Agentic Sandboxes"</span>]
              </span>
            </div>
            <div class="kv-row">
              <span class="kv-key">"academic_priors"</span>
              <span class="kv-val">
                PhD in Thermodynamics (<a href="https://www.ntu.edu.sg/" target="_blank" rel="noopener noreferrer">NTU Singapore</a>)
                {' '}&rarr; Visiting Researcher (<a href="https://www.tohoku.ac.jp/en/" target="_blank" rel="noopener noreferrer">Tohoku Univ.</a>)
                {' '}&rarr; <a href="https://education.wolfram.com/summer-school/alumni/2013/baichuan-sun/" target="_blank" rel="noopener noreferrer">Wolfram Science Summer School</a>
                {' '}&rarr; 3-yr Computational Nanophysics Postdoc (<a href="https://www.csiro.au/" target="_blank" rel="noopener noreferrer">CSIRO</a>)
              </span>
            </div>
            <div class="kv-row">
              <span class="kv-key">"hardware_quirk"</span>
              <span class="kv-val">
                Thin local client + split mechanical keyboard &rarr; ephemeral multi-GPU cloud devboxes over SSH/RDMA
              </span>
            </div>
          </div>

          <div class="cmd-line" style="margin-top: 1.75rem;">
            <span class="t-sigil">~$</span>
            <span class="t-cmd">cat</span>
            <span class="t-arg">~/philosophy.md</span>
          </div>

          <div class="term-prose">
            <p>
              My training started in statistical mechanics, non-equilibrium thermodynamics, and molecular-scale simulation,
              long before LLMs ate the software world. Once you spend years debugging partition functions, energy landscapes,
              and numerical integrators that blow up at stiff boundaries, modern deep learning stops looking like magic and
              starts looking like familiar applied math running against very concrete silicon ceilings.
            </p>
            <p>
              Most production failures I debug sit in the seam between <strong>math</strong> and <strong>mechanics</strong>:
              an on-policy RL loop whose autoregressive KV-cache starves FSDP backward passes of HBM headroom, a collective
              all-reduce silently falling back from RDMA to TCP, or an evaluation harness that leaks state across rollouts.
              This notebook is where I write down the clean mental models, proofs, and reproducible recipes after the dust settles.
            </p>
          </div>

          <div class="cmd-line" style="margin-top: 1.6rem;">
            <span class="t-sigil">~$</span>
            <span class="t-cmd">mcp list-endpoints</span>
            <span class="t-flag">--public</span>
          </div>

          <div class="endpoint-row">
            <a href="https://github.com/sunbc0120" target="_blank" rel="noopener noreferrer" class="ep-pill">
              <span class="ep-proto">git://</span>github.com/sunbc0120
            </a>
            <a href="https://www.linkedin.com/in/sunbc0120" target="_blank" rel="noopener noreferrer" class="ep-pill">
              <span class="ep-proto">https://</span>linkedin.com/in/sunbc0120
            </a>
            <a href="https://stackoverflow.com/users/3317548" target="_blank" rel="noopener noreferrer" class="ep-pill">
              <span class="ep-proto">so://</span>users/3317548
            </a>
            <a href={`${base}/rss.xml`} class="ep-pill">
              <span class="ep-proto">feed://</span>rss.xml
            </a>
          </div>
        </section>

        <!-- TAB 2: ROOFLINE & MATH STACK -->
        <section
          id="panel-stack"
          role="tabpanel"
          aria-labelledby="tab-stack"
          class="term-panel"
          data-panel="stack"
          hidden
        >
          <div class="cmd-line">
            <span class="t-sigil">~$</span>
            <span class="t-cmd">./roofline-stack.sh</span>
            <span class="t-flag">--verbose</span>
          </div>

          <div class="stack-grid">
            <div class="stack-card">
              <div class="stack-head">
                <span class="t-cyan">[01] Silicon, Kernels &amp; Cluster Fabric</span>
                <span class="t-emerald">COMPUTE / HBM</span>
              </div>
              <div class="meter-bar"><span style="width: 94%"></span></div>
              <ul class="stack-list">
                <li><strong>Memory &amp; Roofline:</strong> Arithmetic intensity budgeting, HBM3e capacity planning, KV-cache paging (<code>vLLM</code>), activation checkpointing vs. recompute trade-offs.</li>
                <li><strong>Kernels &amp; Compilers:</strong> <code>PyTorch 2</code> (<code>torch.compile</code> / <code>Dynamo</code> / <code>Inductor</code>), custom <code>Triton</code> fused ops, <code>FP8</code> / <code>BF16</code> mixed-precision numerics, Perfetto &amp; Nsight profiling.</li>
                <li><strong>Distributed Execution:</strong> <code>FSDP2</code>, tensor/pipeline parallelism, multi-NIC <code>GPUDirect-RDMA</code> &amp; <code>NCCL</code> topology tuning on <code>GKE</code> + <code>Ray</code>.</li>
              </ul>
            </div>

            <div class="stack-card">
              <div class="stack-head">
                <span class="t-amber">[02] Post-Training &amp; Mathematical Foundations</span>
                <span class="t-emerald">OPTIMIZATION</span>
              </div>
              <div class="meter-bar amber"><span style="width: 92%"></span></div>
              <ul class="stack-list">
                <li><strong>Reinforcement Learning:</strong> Synchronous &amp; asynchronous on-policy <code>GRPO</code> / <code>PPO</code>, group-normalized advantage estimation, KL divergence control, verifiable reward sandboxes.</li>
                <li><strong>Physical &amp; Statistical Math:</strong> Statistical mechanics, Monte Carlo sampling, stochastic differential equations, convex/non-convex optimization, number-theoretic cryptography.</li>
              </ul>
            </div>

            <div class="stack-card">
              <div class="stack-head">
                <span class="t-purple">[03] Agentic Systems &amp; Engineering Rigor</span>
                <span class="t-emerald">ARCHITECTURE</span>
              </div>
              <div class="meter-bar purple"><span style="width: 90%"></span></div>
              <ul class="stack-list">
                <li><strong>Tooling &amp; State Isolation:</strong> Model Context Protocol (<code>MCP</code>) servers, copy-on-write (<code>CoW</code>) filesystem time-travel for reproducible agent evaluation, context-window offloading.</li>
                <li><strong>Zero-Slop Rule:</strong> Every claim should trace back to a primary benchmark, an equation you can derive by hand, or a minimal script anyone can run.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- TAB 3: GIT LOG CAREER GRAPH -->
        <section
          id="panel-log"
          role="tabpanel"
          aria-labelledby="tab-log"
          class="term-panel"
          data-panel="log"
          hidden
        >
          <div class="cmd-line">
            <span class="t-sigil">~$</span>
            <span class="t-cmd">git log</span>
            <span class="t-flag">--graph --abbrev-commit --decorate</span>
            <span class="t-arg">career</span>
          </div>

          <div class="git-graph">
            <div class="git-entry">
              <div class="git-rail"><span class="git-node head"></span></div>
              <div class="git-body">
                <div class="git-meta">
                  <span class="git-hash">c8f4a21</span>
                  <span class="git-ref head">(HEAD -&gt; main, tag: google-cloud)</span>
                  <span class="git-loc">Melbourne, AU</span>
                </div>
                <div class="git-title">Applied Solutions Architect &middot; Google Cloud (APAC)</div>
                <p class="git-desc">
                  Architecting large-scale GPU post-training (GRPO / RLHF), high-throughput open-weight serving, and
                  production GenAI &amp; agentic platforms on multi-node accelerator clusters.
                </p>
              </div>
            </div>

            <div class="git-entry">
              <div class="git-rail"><span class="git-node"></span></div>
              <div class="git-body">
                <div class="git-meta">
                  <span class="git-hash">94e1b07</span>
                  <span class="git-ref">(tag: aws-proserv, tag: mckinsey)</span>
                  <span class="git-loc">Australia</span>
                </div>
                <div class="git-title">Senior Data Scientist &amp; ML Consultant &middot; AWS AI/ML ProServ &amp; McKinsey</div>
                <p class="git-desc">
                  Built and shipped end-to-end production ML systems across computer vision, quantitative forecasting,
                  dynamic pricing optimization, predictive maintenance, and pharma R&amp;D.
                </p>
              </div>
            </div>

            <div class="git-entry">
              <div class="git-rail"><span class="git-node"></span></div>
              <div class="git-body">
                <div class="git-meta">
                  <span class="git-hash">52d09c4</span>
                  <span class="git-ref">(tag: csiro-postdoc)</span>
                  <span class="git-loc">Australia</span>
                </div>
                <div class="git-title">Postdoctoral Fellow in Computational Nanophysics &amp; Chemistry &middot; CSIRO</div>
                <p class="git-desc">
                  Three years of HPC simulation, statistical mechanics, and nanoscale materials modeling on supercomputing clusters.
                </p>
              </div>
            </div>

            <div class="git-entry">
              <div class="git-rail"><span class="git-node"></span></div>
              <div class="git-body">
                <div class="git-meta">
                  <span class="git-hash">1a09e3c</span>
                  <span class="git-ref">(tag: phd-ntu, tag: wolfram-2013, tag: tohoku)</span>
                  <span class="git-loc">SG &middot; JP &middot; US &middot; CN</span>
                </div>
                <div class="git-title">PhD in Thermodynamics (NTU Singapore) &amp; B.Eng in Mechanical Engineering</div>
                <p class="git-desc">
                  Visiting research scholar at Tohoku University (Japan) and alumnus of the 2013 Wolfram Science Summer School (USA).
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Interactive Command Output Log -->
        <div id="interactive-log" class="interactive-log" aria-live="polite"></div>

        <!-- Interactive Shell Input Bar -->
        <form id="term-form" class="term-input-row" autocomplete="off">
          <label for="term-input" class="t-sigil">~$</label>
          <input
            id="term-input"
            type="text"
            class="term-input"
            placeholder="type a command (try: pwd, nvidia-smi, euler, stack, log, clear, help)..."
            spellcheck="false"
          />
          <button type="submit" class="term-run-btn">Run &crarr;</button>
        </form>

        <div class="quick-cmds" aria-label="Quick terminal commands">
          <span class="quick-label">quick exec:</span>
          <button type="button" class="q-chip" data-cmd="pwd">pwd</button>
          <button type="button" class="q-chip" data-cmd="nvidia-smi">nvidia-smi</button>
          <button type="button" class="q-chip" data-cmd="euler">euler</button>
          <button type="button" class="q-chip" data-cmd="stack">stack</button>
          <button type="button" class="q-chip" data-cmd="log">git log</button>
          <button type="button" class="q-chip" data-cmd="clear">clear</button>
        </div>
      </div>

      <!-- Terminal Status Bar + Employer Disclaimer -->
      <div class="term-statusbar">
        <span>
          <strong>Personal Capacity Notice:</strong> Notes, code, benchmarks, and opinions on this site are strictly my own
          and do not represent the views or official positions of Google or any past employer.
        </span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-shell {
    max-width: 920px;
    margin: 0 auto;
  }

  .term-window {
    --t-bg: #ffffff;
    --t-chrome: #f1f5f9;
    --t-surface: #f8fafc;
    --t-border: #cbd5e1;
    --t-border-soft: #e2e8f0;
    --t-fg: #0f172a;
    --t-sub: #334155;
    --t-muted: #64748b;
    --t-emerald: #059669;
    --t-emerald-bg: rgba(5, 150, 105, 0.1);
    --t-cyan: #0284c7;
    --t-cyan-bg: rgba(2, 132, 199, 0.1);
    --t-amber: #b45309;
    --t-purple: #6d28d9;
    --t-str: #0f766e;

    border-radius: 14px;
    border: 1px solid var(--t-border);
    background: var(--t-bg);
    box-shadow: var(--shadow-hover);
    overflow: hidden;
  }

  :global([data-theme="dark"]) .term-window {
    --t-bg: #0d131c;
    --t-chrome: #131b27;
    --t-surface: #111926;
    --t-border: #263449;
    --t-border-soft: #1e293b;
    --t-fg: #e6edf3;
    --t-sub: #b6c2cf;
    --t-muted: #6e7f96;
    --t-emerald: #34d399;
    --t-emerald-bg: rgba(52, 211, 153, 0.14);
    --t-cyan: #38bdf8;
    --t-cyan-bg: rgba(56, 189, 248, 0.14);
    --t-amber: #fbbf24;
    --t-purple: #a78bfa;
    --t-str: #6ee7b7;
  }

  .term-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 1rem 0;
    background: var(--t-chrome);
    border-bottom: 1px solid var(--t-border-soft);
    flex-wrap: wrap;
  }

  .term-lights {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding-bottom: 0.55rem;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    display: inline-block;
  }
  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .term-tabs {
    display: flex;
    align-items: flex-end;
    gap: 0.3rem;
    overflow-x: auto;
  }

  .term-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.48rem 0.9rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    color: var(--t-muted);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }

  .term-tab:hover {
    color: var(--t-fg);
  }

  .term-tab.active {
    color: var(--t-fg);
    background: var(--t-bg);
    border-color: var(--t-border-soft);
    font-weight: 600;
  }

  .tab-idx {
    font-size: 0.68rem;
    padding: 0.05rem 0.34rem;
    border-radius: 4px;
    background: var(--t-cyan-bg);
    color: var(--t-cyan);
  }

  .term-tty-meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    color: var(--t-muted);
    padding-bottom: 0.55rem;
  }

  .term-viewport {
    padding: 1.65rem 1.85rem 1.4rem;
    color: var(--t-fg);
  }

  .cmd-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.86rem;
    margin-bottom: 1rem;
  }

  .t-sigil {
    color: var(--t-emerald);
    font-weight: 700;
    font-family: "JetBrains Mono", monospace;
  }
  .t-cmd { color: var(--t-cyan); font-weight: 600; }
  .t-flag { color: var(--t-amber); }
  .t-arg { color: var(--t-fg); }
  .t-str { color: var(--t-str); }
  .t-cyan { color: var(--t-cyan); }
  .t-amber { color: var(--t-amber); }
  .t-purple { color: var(--t-purple); }
  .t-emerald { color: var(--t-emerald); }
  .t-comment {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.76rem;
    color: var(--t-muted);
  }

  .mcp-banner {
    padding: 1.25rem 1.4rem;
    border-radius: 10px;
    border: 1px solid var(--t-border-soft);
    background: var(--t-surface);
    margin-bottom: 1.25rem;
  }

  .mcp-banner-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }

  .t-badge-emerald,
  .t-badge-cyan {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-right: 0.35rem;
  }

  .t-badge-emerald {
    color: var(--t-emerald);
    background: var(--t-emerald-bg);
  }

  .t-badge-cyan {
    color: var(--t-cyan);
    background: var(--t-cyan-bg);
  }

  .mcp-name {
    margin: 0 0 0.45rem;
    font-size: clamp(1.55rem, 2.8vw, 2.05rem);
    letter-spacing: -0.025em;
    color: var(--t-fg);
  }

  .mcp-tagline {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--t-sub);
  }

  .kv-grid {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    border: 1px dashed var(--t-border);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  .kv-row {
    display: grid;
    grid-template-columns: 185px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }

  .kv-key {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.81rem;
    color: var(--t-cyan);
    font-weight: 600;
  }

  .kv-val {
    color: var(--t-sub);
  }

  .kv-val a {
    color: var(--t-cyan);
  }

  .term-prose p {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    line-height: 1.72;
    color: var(--t-sub);
  }

  .term-prose p:last-child {
    margin-bottom: 0;
  }

  .endpoint-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .ep-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.78rem;
    border-radius: 7px;
    border: 1px solid var(--t-border-soft);
    background: var(--t-surface);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    color: var(--t-fg);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .ep-pill:hover {
    border-color: var(--t-cyan);
    color: var(--t-cyan);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .ep-proto {
    color: var(--t-emerald);
    margin-right: 0.15rem;
  }

  /* Tab 2: Stack Cards */
  .stack-grid {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .stack-card {
    padding: 1.15rem 1.3rem;
    border-radius: 10px;
    border: 1px solid var(--t-border-soft);
    background: var(--t-surface);
  }

  .stack-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.83rem;
    font-weight: 600;
    margin-bottom: 0.55rem;
  }

  .meter-bar {
    height: 5px;
    border-radius: 999px;
    background: var(--t-border-soft);
    overflow: hidden;
    margin-bottom: 0.85rem;
  }

  .meter-bar > span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--t-cyan), var(--t-emerald));
  }

  .meter-bar.amber > span {
    background: linear-gradient(90deg, var(--t-amber), var(--t-emerald));
  }

  .meter-bar.purple > span {
    background: linear-gradient(90deg, var(--t-purple), var(--t-cyan));
  }

  .stack-list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--t-sub);
  }

  .stack-list li {
    margin-bottom: 0.45rem;
  }

  .stack-list li:last-child {
    margin-bottom: 0;
  }

  .stack-list code {
    font-size: 0.82em;
    padding: 0.1em 0.38em;
    border-radius: 4px;
    background: var(--t-cyan-bg);
    color: var(--t-cyan);
  }

  /* Tab 3: Git Graph */
  .git-graph {
    display: flex;
    flex-direction: column;
  }

  .git-entry {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 0.6rem;
  }

  .git-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .git-rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--t-border);
  }

  .git-entry:last-child .git-rail::before {
    bottom: 55%;
  }

  .git-node {
    position: relative;
    z-index: 1;
    margin-top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--t-bg);
    border: 2.5px solid var(--t-cyan);
  }

  .git-node.head {
    border-color: var(--t-emerald);
    background: var(--t-emerald);
  }

  .git-body {
    padding-bottom: 1.35rem;
  }

  .git-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    margin-bottom: 0.25rem;
  }

  .git-hash {
    color: var(--t-amber);
    font-weight: 600;
  }

  .git-ref {
    color: var(--t-cyan);
  }

  .git-ref.head {
    color: var(--t-emerald);
    font-weight: 600;
  }

  .git-loc {
    color: var(--t-muted);
  }

  .git-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--t-fg);
    margin-bottom: 0.25rem;
  }

  .git-desc {
    margin: 0;
    font-size: 0.91rem;
    line-height: 1.6;
    color: var(--t-sub);
  }

  /* Interactive Output & Prompt */
  .interactive-log {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .interactive-log:empty {
    display: none;
  }

  :global(.repl-item) {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--t-surface);
    border: 1px solid var(--t-border-soft);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--t-sub);
    overflow-x: auto;
  }

  :global(.repl-item pre) {
    margin: 0.4rem 0 0;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--t-fg);
  }

  .term-input-row {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--t-border-soft);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .term-input {
    flex: 1;
    min-width: 0;
    background: var(--t-surface);
    border: 1px solid var(--t-border-soft);
    border-radius: 7px;
    padding: 0.48rem 0.75rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.82rem;
    color: var(--t-fg);
    outline: none;
  }

  .term-input:focus {
    border-color: var(--t-cyan);
  }

  .term-run-btn {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.48rem 0.85rem;
    border-radius: 7px;
    border: 1px solid var(--t-border);
    background: var(--t-surface);
    color: var(--t-cyan);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .term-run-btn:hover {
    border-color: var(--t-cyan);
    color: var(--t-emerald);
  }

  .quick-cmds {
    margin-top: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .quick-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    color: var(--t-muted);
    margin-right: 0.2rem;
  }

  .q-chip {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    padding: 0.18rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--t-border-soft);
    background: transparent;
    color: var(--t-muted);
    cursor: pointer;
    transition: all 0.14s ease;
  }

  .q-chip:hover {
    border-color: var(--t-cyan);
    color: var(--t-cyan);
  }

  .term-statusbar {
    padding: 0.75rem 1.4rem;
    background: var(--t-chrome);
    border-top: 1px solid var(--t-border-soft);
    font-size: 0.78rem;
    color: var(--t-muted);
    line-height: 1.5;
  }

  @media (max-width: 680px) {
    .term-viewport {
      padding: 1.2rem 1.05rem;
    }
    .kv-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .term-tty-meta {
      display: none;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.term-tab[data-tab]');
  const panels = document.querySelectorAll<HTMLElement>('.term-panel[data-panel]');
  const logEl = document.getElementById('interactive-log');
  const form = document.getElementById('term-form') as HTMLFormElement | null;
  const input = document.getElementById('term-input') as HTMLInputElement | null;
  const chips = document.querySelectorAll<HTMLButtonElement>('.q-chip[data-cmd]');

  function activateTab(name: string) {
    tabs.forEach((t) => {
      const isMatch = t.dataset.tab === name;
      t.classList.toggle('active', isMatch);
      t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
    });
    panels.forEach((p) => {
      const isMatch = p.dataset.panel === name;
      p.classList.toggle('active', isMatch);
      p.hidden = !isMatch;
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.dataset.tab) activateTab(tab.dataset.tab);
    });
  });

  function appendOutput(cmd: string, output: string) {
    if (!logEl) return;
    const item = document.createElement('div');
    item.className = 'repl-item';
    const header = document.createElement('div');
    header.innerHTML = `<span style="color:var(--t-emerald);font-weight:700;">~$</span> <span style="color:var(--t-cyan);">${cmd.replace(/[<>&]/g, '')}</span>`;
    const pre = document.createElement('pre');
    pre.textContent = output;
    item.appendChild(header);
    item.appendChild(pre);
    logEl.appendChild(item);
    item.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function runCommand(raw: string) {
    const cmd = raw.trim();
    if (!cmd) return;
    const lower = cmd.toLowerCase();

    if (lower === 'clear' || lower === 'cls') {
      if (logEl) logEl.innerHTML = '';
      return;
    }
    if (lower === 'card' || lower.startsWith('mcp')) {
      activateTab('card');
      appendOutput(cmd, '-> Switched active buffer to [1] mcp-card.json ("SUN\'s Blog" engineer card).');
      return;
    }
    if (lower === 'stack' || lower === 'roofline') {
      activateTab('stack');
      appendOutput(cmd, '-> Switched active buffer to [2] roofline-stack.sh.');
      return;
    }
    if (lower === 'log' || lower === 'git log') {
      activateTab('log');
      appendOutput(cmd, '-> Switched active buffer to [3] git-log career graph.');
      return;
    }
    if (lower === 'pwd') {
      appendOutput(cmd, '/home/baichuan/sun-blog\n↳ stdout: "SUN\'s Blog"');
      return;
    }
    if (lower === 'whoami') {
      appendOutput(cmd, 'baichuan.sun (PhD, Applied AI & Distributed GPU Systems, Melbourne AU)');
      return;
    }
    if (lower === 'nvidia-smi') {
      appendOutput(
        cmd,
        [
          '+-----------------------------------------------------------------------------------------+',
          '| SUN-BLOG-NODE   Driver: 570.xx        CUDA: 12.8        Fabric: 8x NIC RDMA + NVLink    |',
          '|-------------------------------+------------------------+--------------------------------|',
          '| GPU  Name            TCC/WDDM | Bus-Id          Disp.A | Volatile Uncorr. ECC           |',
          '|   0  HBM3e-Tensor-0     Off   | 00000000:01:00.0   Off |                              0 |',
          '|   7  HBM3e-Tensor-7     Off   | 00000000:08:00.0   Off |                              0 |',
          '+-------------------------------+------------------------+--------------------------------+',
          '| Active Process: synchronous_grpo_loop.py   | Regime: Compute-Bound   | AI-Slop: 0.00%   |',
          '+-----------------------------------------------------------------------------------------+',
        ].join('\n')
      );
      return;
    }
    if (lower === 'euler' || lower === 'math') {
      appendOutput(
        cmd,
        [
          'Partition Function  : Z = sum_i exp(-beta * E_i)',
          'Roofline Ceiling    : Perf(I) = min(Peak_FLOPS, I * Peak_HBM_BW)',
          'Euler Totient (RSA) : m^phi(n) === 1 (mod n)  =>  (m^e)^k mod n = m',
        ].join('\n')
      );
      return;
    }
    if (lower === 'help' || lower === '?') {
      appendOutput(
        cmd,
        'Available commands:\n  pwd          Print notebook path\n  whoami       Short identity summary\n  nvidia-smi   Inspect virtual GPU node telemetry\n  euler        Print favorite physics/hardware/crypto identities\n  card         Switch to Tab 1 (mcp-card.json)\n  stack        Switch to Tab 2 (roofline-stack.sh)\n  log          Switch to Tab 3 (git-log)\n  clear        Clear interactive output buffer'
      );
      return;
    }

    appendOutput(cmd, `zsh: command not found: ${cmd} (type "help" to list supported commands)`);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    runCommand(input.value);
    input.value = '';
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      if (chip.dataset.cmd) runCommand(chip.dataset.cmd);
    });
  });
</script>
